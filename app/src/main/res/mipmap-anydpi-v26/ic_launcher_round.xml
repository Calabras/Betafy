        <ellipse cx="512" cy="515" rx="270" ry="230"
            fill="#C5EAC6" opacity="0.10"
            filter="url(#logoGlow)"/>

        <!-- ЦЕНТРАЛЬНЫЙ ЛОГОТИП B -->
        <path d="
            M320 355
            H625
            C710 355 755 393 755 460
            C755 510 725 540 680 555
            C735 570 760 610 760 660
            C760 730 715 765 630 765
            H320 Z"
