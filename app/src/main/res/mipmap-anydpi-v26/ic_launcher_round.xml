
<svg xmlns="http://www.w3.org/2000/svg"
    width="1024" height="1024"
    viewBox="0 0 1024 1024">

    <defs>
        <clipPath id="iconClip">
            <rect x="20" y="20" width="984" height="984" rx="190"/>
        </clipPath>

        <!-- Основной градиент -->
        <radialGradient id="bg" cx="50%" cy="48%" r="75%">
            <stop offset="0%" stop-color="#002C20"/>
            <stop offset="55%" stop-color="#003D2A"/>
            <stop offset="100%" stop-color="#001C15"/>
        </radialGradient>

        <!-- Градиенты волн -->
        <linearGradient id="waveTop" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#276F50"/>
            <stop offset="55%" stop-color="#14563C"/>
            <stop offset="100%" stop-color="#073A2A"/>
        </linearGradient>

        <linearGradient id="waveBottom" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#4B966B"/>
            <stop offset="50%" stop-color="#246B4C"/>
            <stop offset="100%" stop-color="#0B4934"/>
        </linearGradient>

        <linearGradient id="waveSide" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#39835C"/>
            <stop offset="100%" stop-color="#0A3929"/>
        </linearGradient>

        <!-- Центральная эмблема -->
        <linearGradient id="cream" x1="0" y1="0" x2="0.8" y2="1">
            <stop offset="0%" stop-color="#FFF9EC"/>
            <stop offset="100%" stop-color="#EDE2CC"/>
        </linearGradient>

        <!-- Пастельные капсулы -->
        <linearGradient id="purple" x1="0" y1="0" x2="0.9" y2="1">
            <stop offset="0%" stop-color="#F0D5FF"/>
            <stop offset="65%" stop-color="#C58AEF"/>
            <stop offset="100%" stop-color="#A66BDB"/>
        </linearGradient>

        <linearGradient id="yellow" x1="0" y1="0" x2="0.9" y2="1">
            <stop offset="0%" stop-color="#FFF1BD"/>
            <stop offset="65%" stop-color="#FFD47A"/>
            <stop offset="100%" stop-color="#F2B54D"/>
        </linearGradient>

        <linearGradient id="peach" x1="0" y1="0" x2="0.9" y2="1">
            <stop offset="0%" stop-color="#FFD9C1"/>
            <stop offset="65%" stop-color="#FFA98B"/>
            <stop offset="100%" stop-color="#F47E65"/>
        </linearGradient>

        <linearGradient id="mint" x1="0" y1="0" x2="0.9" y2="1">
            <stop offset="0%" stop-color="#D9F6CE"/>
            <stop offset="65%" stop-color="#A5E3B3"/>
            <stop offset="100%" stop-color="#72C49A"/>
        </linearGradient>

        <!-- Тени -->
        <filter id="softShadow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="16"/>
        </filter>

        <filter id="logoGlow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="22"/>
        </filter>
    </defs>

    <g clip-path="url(#iconClip)">

        <!-- ФОН -->
        <rect width="1024" height="1024" fill="url(#bg)"/>

        <!-- Верхняя волна -->
        <path d="
